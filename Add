#include <iostream>
using namespace std;

int add(int a, int b) {
    return a + b;
}

float add(float a, float b) {
    return a + b;
}

int main() {
    int i1, i2;
    float f1, f2;

    cout << "Enter two integers: ";
    cin >> i1 >> i2;

    cout << "Enter two floating-point numbers: ";
    cin >> f1 >> f2;

    cout << "Sum of integers: " << add(i1, i2) << endl;
    cout << "Sum of floating-point numbers: " << add(f1, f2) << endl;

    return 0;
}
