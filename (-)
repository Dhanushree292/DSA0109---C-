#include<iostream>
using namespace std;
class complex
{
  private:
  int real,imag;
  public:
  complex(int r=0,int i=0)
  {
    real=r;
    imag=i;
  }
  complex operator-( complex c)
  { 
    complex temp;
    temp.real=real-c.real;
    temp.imag=imag-c.imag;
    return temp;
  }
  void display()
  {
    cout<<real;
    if(imag>=0)
      cout<<"+"<<imag<<"i";
    else
      cout<<"-"<<-imag<<"i";
  }
  };
int main()
{
  complex c1(8,6), c2(3,2), c3;
  c3 = c1 - c2;
  
  cout<<"first complex number: ";
  c1.display();
  cout<<"\n second complex number: ";
  c2.display();
  cout<<"\n subtraction: ";
  c3.display();
  cout<<endl;
  
  return 0;
}
