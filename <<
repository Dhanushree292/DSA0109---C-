#include <iostream>
#include <string>
using namespace std;

class Student
{
private:
    string name;
    int age;

public:
    void getData()
    {
        getline(cin, name);
        cin >> age;
    }

    friend ostream& operator<<(ostream &out, Student s);
};

ostream& operator<<(ostream &out, Student s)
{
    out << "Name: " << s.name << endl;
    out << "Age: " << s.age;
    return out;
}

int main()
{
    Student s;
    s.getData();

    cout << s;

    return 0;
}
